NODE_ENV=development
API_PORT=4000
# Incident operations require MongoDB replica-set transactions. Docker Compose initializes rs0.
MONGODB_URI=mongodb://localhost:27017/flowryn?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379
# redis is required for horizontal scaling and all production deployments.
# memory is allowed only with NODE_ENV=development (tests default to memory).
REALTIME_COORDINATION=redis
JWT_SECRET=replace-with-a-long-random-secret
VITE_API_URL=http://localhost:4000
SOCKET_ALLOWED_ORIGINS=http://localhost:5173
# Generate a private 32-byte hex key; no fallback key is provided.
# JSON map example shape: {"1":"<64 hex characters>"}
AUTOMATION_ENCRYPTION_KEYS={}
AUTOMATION_KEY_VERSION=1
AUTOMATION_CONCURRENCY=4
# Shared by automation events/actions, on-call escalation and suppression expiry.
AUTOMATION_POLL_MS=1000
AUTOMATION_HEALTH_PORT=4001
# Status subscriber addresses use the same authenticated-encryption keyring. Delivery remains
# unavailable until an approved email or signed-webhook adapter is configured.
# Optional signing secret (at least 32 characters) enables SSRF-protected HTTPS webhook delivery.
STATUS_WEBHOOK_SIGNING_SECRET=
# Stable 32-byte hex HMAC key for subscriber lookup; do not rotate with encryption keys.
STATUS_SUBSCRIBER_LOOKUP_KEY=
